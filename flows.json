    {
        "id": "c7ac2adf6471e236",
        "type": "function",
        "z": "f0964d0e4277030e",
        "name": "Set Threshold + API Key",
        "func": "var apiKey = msg.req.headers['x-api-key'];\nif (apiKey !== 'iot-key-2026') {\n  msg.statusCode = 401;\n  msg.payload = {status: 'error', message: 'Unauthorized: X-API-Key salah atau kosong'};\n  msg.headers = {'Access-Control-Allow-Origin': '*'};\n  return msg;\n}\n\nvar batas = parseFloat(msg.payload.threshold);\nif (isNaN(batas)) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'Nilai threshold harus angka'};\n  msg.headers = {'Access-Control-Allow-Origin': '*'};\n  return msg;\n}\n\nflow.set('threshold', batas);\nmsg.statusCode = 200;\nmsg.payload = {status: 'success', message: 'Batas suhu diatur ke ' + batas + '°C', threshold: batas};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nmsg.topic = 'iot/kontrol';\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
