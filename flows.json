        "z": "f0964d0e4277030e",
        "name": "Build Response Suhu",
        "func": "var threshold = flow.get('threshold') || 30.0;\nvar data = flow.get('lastSensor') || {suhu: null, kelembaban: null, timestamp: null, threshold: threshold, alert: false};\nmsg.payload = {\n  status: 'success',\n  data: data,\n  server_time: new Date().toISOString()\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn msg;",
