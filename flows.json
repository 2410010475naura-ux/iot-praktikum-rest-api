    {
        "id": "31c679b94595ce6f",
        "type": "function",
        "z": "f0964d0e4277030e",
        "name": "Validasi API Key & Publish",
        "func": "var apiKey = msg.req.headers['x-api-key'];\nif (apiKey !== 'iot-key-2026') {\n  msg.statusCode = 401;\n  msg.payload = {status: 'error', message: 'Unauthorized: X-API-Key salah atau kosong'};\n  msg.headers = {'Access-Control-Allow-Origin': '*'};\n  return [msg, null];\n}\n\nvar body = msg.payload;\nif (!body.device || !body.action) {\n  msg.statusCode = 400;\n  msg.payload = {status: 'error', message: 'device dan action wajib diisi'};\n  msg.headers = {'Access-Control-Allow-Origin': '*'};\n  return [msg, null];\n}\n\nvar mqttMsg = {payload: body, topic: 'iot/kontrol'};\nnode.send([null, mqttMsg]);\n\nmsg.statusCode = 200;\nmsg.payload = {\n  status: 'success',\n  message: 'Perintah terkirim',\n  sent: body\n};\nmsg.headers = {'Access-Control-Allow-Origin': '*'};\nreturn [msg, null];",
