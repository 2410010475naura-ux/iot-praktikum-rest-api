    {
        "id": "d871a2aeedb9308e",
        "type": "function",
        "z": "f0964d0e4277030e",
        "name": "Simpan Data & Cek Threshold",
        "func": "var data = msg.payload;\ndata.received = new Date().toISOString();\n\nvar threshold = flow.get('threshold') || 30.0;\ndata.threshold = threshold;\ndata.alert = data.suhu > threshold;\n\nflow.set('lastSensor', data);\n\nvar history = flow.get('history') || [];\nhistory.push(data);\nif (history.length > 50) history.shift();\nflow.set('history', history);\n\nreturn msg;",
        "outputs": 1,
        "x": 410,
        "y": 80,
        "wires": [
            [
                "bf6644bc3f37d3b1"
            ]
        ]
    },
